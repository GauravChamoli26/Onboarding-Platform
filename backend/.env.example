# ============================================================================
# .env.example — copy to .env for local development
# ----------------------------------------------------------------------------
# Never commit .env. Real secrets live in AWS Secrets Manager (ADR-014).
# This file documents every variable the application reads.
# ============================================================================

# --- Environment ------------------------------------------------------------
# One of: local | dev | staging | production
# Controls logging verbosity and whether debug endpoints are mounted.
APP_ENV=local

# --- Database ---------------------------------------------------------------
# IMPORTANT: the application connects as a NON-SUPERUSER role.
# PostgreSQL exempts superusers and table owners from row-level security,
# so connecting as the owner would silently disable every tenant boundary.
# See ADR-002 and scripts/init-db.sql.
DATABASE_URL=postgresql+asyncpg://app_user:app_password@localhost:5432/onboarding

# Connection pool sizing. Small for local; production values come from Terraform.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Region / residency -----------------------------------------------------
# ADR-014: adapters assert this per call and fail closed on a non-India endpoint
# for any PII-bearing payload. Changing this does not relax the check — it is
# validated against an allowlist in settings.py.
AWS_REGION=ap-south-1

# --- Application ------------------------------------------------------------
# Organisation-level default; per-tenant timezone overrides live in the database.
DEFAULT_TIMEZONE=Asia/Kolkata
